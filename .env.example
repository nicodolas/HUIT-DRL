# ==============================================================================
# HUIT DRL - BIẾN MÔI TRƯỜNG MẪU (.env.example)
# ==============================================================================
# Sao chép file này thành .env.local và điền các giá trị thực tế của bạn
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU NEON POSTGRESQL (PRODUCTION DATABASE)
# ------------------------------------------------------------------------------
DATABASE_URL_OWNER="postgresql://neondb_owner:YOUR_OWNER_PASSWORD@ep-sample-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://drl_app_user:YOUR_APP_PASSWORD@ep-sample-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. XÁC THỰC & BẢO MẬT PHIÊN ĐĂNG NHẬP (AUTH & SESSIONS)
# ------------------------------------------------------------------------------
AUTH_SECRET="your-32-byte-hex-or-base64-random-secret"
SESSION_MAX_AGE_SECONDS="604800"

# ------------------------------------------------------------------------------
# 3. ĐƯỜNG DẪN ỨNG DỤNG & TÊN MIỀN HỆ THỐNG
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. ĐƯỜNG LINK MẪU VÀ CỔNG THÔNG TIN HUIT (SAMPLE & OFFICIAL EXTERNAL LINKS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_HUIT_PORTAL_URL="https://sinhvien.huit.edu.vn"
NEXT_PUBLIC_HUIT_QD3385_URL="https://huit.edu.vn/tin-tuc/quy-dinh-danh-gia-ket-qua-ren-luyen-sinh-vien"
NEXT_PUBLIC_SAMPLE_EVIDENCE_DRIVE_URL="https://drive.google.com/drive/folders/sample-huit-drl-proofs"
NEXT_PUBLIC_HUIT_YOUTH_UNION_URL="https://doanhoi.huit.edu.vn"
NEXT_PUBLIC_SUPPORT_EMAIL="drl@huit.edu.vn"
NEXT_PUBLIC_SUPPORT_HOTLINE="02838161673"
